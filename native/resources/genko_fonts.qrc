<!DOCTYPE RCC>
<!-- The screen's letters (IBM Plex Sans JP, SIL OFL; fonts/licenses/), built in. A big resource: compiled straight to
     an object file (qt_add_big_resources). -->
<RCC version="1.0">
  <qresource prefix="/genko">
    <file alias="fonts/IBMPlexSansJP-Regular.ttf">fonts/ui/IBMPlexSansJP-Regular.ttf</file>
    <file alias="fonts/IBMPlexSansJP-Medium.ttf">fonts/ui/IBMPlexSansJP-Medium.ttf</file>
    <file alias="fonts/IBMPlexSansJP-Bold.ttf">fonts/ui/IBMPlexSansJP-Bold.ttf</file>
  </qresource>
</RCC>
